#!/bin/bash

# Dell Precision M4800 fan controller
#
# Fan strategy:
#   QUIET: PWM 75  (~2500 RPM, quiet)
#   HIGH:  i8kctl fan 2 2 (~4900 RPM)
#
# Temperature policy:
#   < 70°C       -> QUIET
#   >= 70°C      -> HIGH
#   HIGH -> QUIET only below 60°C
#
# Important:
#   The M4800's i8kctl readback is unreliable.
#   Do NOT use i8kctl output as feedback.
#   The command itself is treated as successful if it exits 0.
#
# Safety:
#   Sensor failures -> HIGH
#   Control failures -> HIGH
#   Controller shutdown -> HIGH
#
# BIOS fan control must be disabled before this controller runs.

set -u

# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------

INTERVAL=3

# Normal quiet operation
QUIET_PWM=75

# Temperature at which HIGH cooling starts
HIGH_TEMP=70

# Temperature below which HIGH cooling returns to QUIET
HIGH_TO_QUIET_TEMP=60

# Number of consecutive sensor failures before giving up
MAX_SENSOR_FAILURES=3

# Number of consecutive control failures before giving up
MAX_CONTROL_FAILURES=3

I8KCTL="/usr/bin/i8kctl"

# ------------------------------------------------------------
# Runtime state
# ------------------------------------------------------------

CURRENT_LEVEL=""

SENSOR_FAILURES=0
CONTROL_FAILURES=0

CPU_HWMON=""
SMM_HWMON=""

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*"
}

fatal() {
    log "FATAL: $*"
    exit 1
}

# ------------------------------------------------------------
# Find hwmon devices
# ------------------------------------------------------------

find_hwmon_devices() {

    for hwmon in /sys/class/hwmon/hwmon*; do
        [ -d "$hwmon" ] || continue

        name_file="$hwmon/name"

        [ -f "$name_file" ] || continue

        name=$(cat "$name_file" 2>/dev/null || true)

        case "$name" in
            coretemp)
                CPU_HWMON="$hwmon"
                ;;

            dell_smm)
                SMM_HWMON="$hwmon"
                ;;
        esac
    done

    [ -n "$CPU_HWMON" ] || fatal "Unable to find coretemp hwmon device"
    [ -n "$SMM_HWMON" ] || fatal "Unable to find dell_smm hwmon device"

    log "CPU sensor: $CPU_HWMON"
    log "Dell SMM:   $SMM_HWMON"
}

# ------------------------------------------------------------
# Read CPU temperature
# ------------------------------------------------------------

get_cpu_temp() {

    local max_temp=0
    local file
    local value

    for file in "$CPU_HWMON"/temp*_input; do

        [ -r "$file" ] || continue

        value=$(cat "$file" 2>/dev/null || true)

        case "$value" in
            ''|*[!0-9]*)
                continue
                ;;
        esac

        if [ "$value" -gt "$max_temp" ]; then
            max_temp="$value"
        fi
    done

    if [ "$max_temp" -le 0 ]; then
        return 1
    fi

    # Convert millidegrees Celsius to degrees Celsius
    echo $((max_temp / 1000))
}

# ------------------------------------------------------------
# Read GPU temperature
# ------------------------------------------------------------

get_gpu_temp() {

    local file
    local label
    local value

    for file in "$SMM_HWMON"/temp*_input; do

        [ -r "$file" ] || continue

        label_file="${file%_input}_label"

        [ -r "$label_file" ] || continue

        label=$(cat "$label_file" 2>/dev/null || true)

        if [ "$label" = "GPU" ]; then

            value=$(cat "$file" 2>/dev/null || true)

            case "$value" in
                ''|*[!0-9]*)
                    return 1
                    ;;
            esac

            echo $((value / 1000))
            return 0
        fi
    done

    return 1
}

# ------------------------------------------------------------
# Set QUIET fan state
# ------------------------------------------------------------

set_quiet() {

    local pwm1="$SMM_HWMON/pwm1"
    local pwm2="$SMM_HWMON/pwm2"

    [ -w "$pwm1" ] || {
        log "ERROR: $pwm1 is not writable"
        return 1
    }

    [ -w "$pwm2" ] || {
        log "ERROR: $pwm2 is not writable"
        return 1
    }

    if ! echo "$QUIET_PWM" > "$pwm1"; then
        log "ERROR: Failed to set PWM1 to $QUIET_PWM"
        return 1
    fi

    if ! echo "$QUIET_PWM" > "$pwm2"; then
        log "ERROR: Failed to set PWM2 to $QUIET_PWM"
        return 1
    fi

    CURRENT_LEVEL="QUIET"

    log "Fan state: QUIET (PWM $QUIET_PWM)"

    return 0
}

# ------------------------------------------------------------
# Set HIGH fan state
# ------------------------------------------------------------

set_high() {

    # IMPORTANT:
    # On this M4800:
    #
    #   i8kctl fan 2 2
    #
    # actually produces ~4900 RPM, even though i8kctl
    # prints "1 1" afterward.
    #
    # Therefore we intentionally ignore its output.

    if ! "$I8KCTL" fan 2 2 >/dev/null 2>&1; then
        log "ERROR: Failed to command HIGH fan state"
        return 1
    fi

    CURRENT_LEVEL="HIGH"

    log "Fan state: HIGH"

    return 0
}

# ------------------------------------------------------------
# Set safe shutdown state
# ------------------------------------------------------------

set_safe_high() {

    "$I8KCTL" fan 2 2 >/dev/null 2>&1 || true
}

# ------------------------------------------------------------
# Decide fan level
# ------------------------------------------------------------

calculate_level() {

    local temp="$1"

    if [ "$CURRENT_LEVEL" = "HIGH" ]; then

        # Stay HIGH until temperature has fallen
        # sufficiently below the activation threshold.

        if [ "$temp" -lt "$HIGH_TO_QUIET_TEMP" ]; then
            echo "QUIET"
        else
            echo "HIGH"
        fi

        return
    fi

    # Normal state

    if [ "$temp" -ge "$HIGH_TEMP" ]; then
        echo "HIGH"
    else
        echo "QUIET"
    fi
}

# ------------------------------------------------------------
# Apply requested fan level
# ------------------------------------------------------------

apply_level() {

    local level="$1"

    case "$level" in

        QUIET)

            if [ "$CURRENT_LEVEL" != "QUIET" ]; then

                if ! set_quiet; then
                    return 1
                fi

            fi

            ;;

        HIGH)

            if [ "$CURRENT_LEVEL" != "HIGH" ]; then

                if ! set_high; then
                    return 1
                fi

            fi

            ;;

        *)
            log "ERROR: Unknown fan level: $level"
            return 1
            ;;
    esac

    return 0
}

# ------------------------------------------------------------
# Trap
# ------------------------------------------------------------

cleanup() {

    log "Controller stopping - setting fans to HIGH"

    set_safe_high

}

trap cleanup EXIT INT TERM

# ------------------------------------------------------------
# Initialization
# ------------------------------------------------------------

log "Starting Dell Precision M4800 fan controller"

find_hwmon_devices

# Start safely at HIGH while sensors are initialized.
if ! set_high; then
    fatal "Unable to set initial HIGH fan state"
fi

# Force the first loop to make a fresh decision.
CURRENT_LEVEL="HIGH"

# ------------------------------------------------------------
# Main loop
# ------------------------------------------------------------

while true; do

    CPU_TEMP=$(get_cpu_temp) || {

        SENSOR_FAILURES=$((SENSOR_FAILURES + 1))

        log "WARNING: Unable to read CPU temperature \
(sensor failure $SENSOR_FAILURES/$MAX_SENSOR_FAILURES)"

        set_high || true

        if [ "$SENSOR_FAILURES" -ge "$MAX_SENSOR_FAILURES" ]; then
            fatal "Too many CPU sensor failures"
        fi

        sleep "$INTERVAL"
        continue
    }

    GPU_TEMP=$(get_gpu_temp) || {

        SENSOR_FAILURES=$((SENSOR_FAILURES + 1))

        log "WARNING: Unable to read GPU temperature \
(sensor failure $SENSOR_FAILURES/$MAX_SENSOR_FAILURES)"

        set_high || true

        if [ "$SENSOR_FAILURES" -ge "$MAX_SENSOR_FAILURES" ]; then
            fatal "Too many GPU sensor failures"
        fi

        sleep "$INTERVAL"
        continue
    }

    # Successful sensor read
    SENSOR_FAILURES=0

    # Use the hottest relevant sensor.
    if [ "$CPU_TEMP" -ge "$GPU_TEMP" ]; then
        TEMP="$CPU_TEMP"
    else
        TEMP="$GPU_TEMP"
    fi

    LEVEL=$(calculate_level "$TEMP")

    log "CPU=${CPU_TEMP}°C GPU=${GPU_TEMP}°C TEMP=${TEMP}°C STATE=${CURRENT_LEVEL} TARGET=${LEVEL}"

    if ! apply_level "$LEVEL"; then

        CONTROL_FAILURES=$((CONTROL_FAILURES + 1))

        log "WARNING: Fan control failure \
(control failure $CONTROL_FAILURES/$MAX_CONTROL_FAILURES)"

        # Safety fallback
        set_high || true

        if [ "$CONTROL_FAILURES" -ge "$MAX_CONTROL_FAILURES" ]; then
            fatal "Too many fan control failures"
        fi

    else

        CONTROL_FAILURES=0

    fi

    sleep "$INTERVAL"

done
